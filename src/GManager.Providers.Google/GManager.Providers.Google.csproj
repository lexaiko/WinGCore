<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GManager.Runtime/GManager.Runtime.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
    <Protobuf Include="Protos/*.proto" ProtoRoot="Protos" GrpcServices="None" />
    <None Update="Protos/LICENSE.microG" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Protos/NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
