<Window x:Class="GManager.Views.NativeDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devices and native accounts — GManager" Width="850" Height="660" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Devices and accounts" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Choose the virtual device used for Google registration and sign-in." TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid x:Name="Workspace" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <Label Content="_Virtual device" Target="{Binding ElementName=Devices}" Padding="0,0,0,6"/>
                <ComboBox x:Name="Devices" MinHeight="36" SelectionChanged="DeviceChanged" AutomationProperties.Name="Virtual device">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Profile.Name}"/><Run Text=" — "/><Run Text="{Binding Profile.Model}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="DeviceInfo" TextWrapping="Wrap" Margin="0,8,0,10"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,18">
                <Button Content="New lab device" Click="NewDevice" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Import profile" Click="Import" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Export profile" Click="Export" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Register / check in" Click="Checkin" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Sign in with Google" Click="SignIn" Padding="12,7" Margin="0,0,0,8" FontWeight="SemiBold"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="Accounts on this device" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="Sessions" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionUnit="FullRow" SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Native account sessions">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                <Button Content="Use selected account" Click="UseAccount" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Test service access" Click="TestAccess" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Remove local session" Click="RemoveSession" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Refresh" Click="Refresh" Padding="12,7" Margin="0,0,8,8"/>
            </WrapPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseWindow" Padding="18,7" Margin="16,0,0,0" IsCancel="True"/>
            <TextBlock x:Name="Status" Text="Loading runtime…" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
