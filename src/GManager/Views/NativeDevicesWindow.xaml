<ui:FluentWindow x:Class="GManager.Views.NativeDevicesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Virtual Devices &amp; Native Accounts — GManager"
                 Width="980" Height="700" MinWidth="860" MinHeight="580"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom macOS TitleBar -->
            <RowDefinition Height="*" />    <!-- Master-Detail Content -->
            <RowDefinition Height="Auto" /> <!-- Glass Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- macOS / Fluent Glass TitleBar -->
        <ui:TitleBar Grid.Row="0" Margin="14,6,14,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AppleSubtleAccentBrush}" Margin="0,0,10,0">
                        <Path Data="{StaticResource GeoDevice}" Fill="{StaticResource AppleAccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Device Studio" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Android Runtime" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Master-Detail Workspace -->
        <Grid x:Name="Workspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" /> <!-- Left Master Pane (Devices List) -->
                <ColumnDefinition Width="*" />   <!-- Right Detail Pane (Device Details & Accounts) -->
            </Grid.ColumnDefinitions>

            <!-- LEFT MASTER PANE: Devices List & Quick Actions -->
            <Border Grid.Column="0"
                    Background="{StaticResource AppleSidebarGlassBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,14,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Master Header -->
                        <RowDefinition Height="Auto" /> <!-- Quick Create Buttons -->
                        <RowDefinition Height="*" />    <!-- Scrollable Devices List -->
                        <RowDefinition Height="Auto" /> <!-- Master Footer Action Bar -->
                    </Grid.RowDefinitions>

                    <!-- Master Header -->
                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="Devices" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock Text="Virtual Hardware" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </DockPanel>

                    <!-- Quick Preset Creation Buttons -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="+ New Pixel 10 Pro XL" Click="NewPixel10"
                                Style="{StaticResource ApplePrimaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                ToolTip="Create a new Pixel 10 Pro XL profile (mustang, Android 15)" />
                        <Button Content="+ New Pixel 9 Pro XL" Click="NewDevice"
                                Style="{StaticResource AppleSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTip="Create a new Pixel 9 Pro XL profile (komodo, Android 14)" />
                    </StackPanel>

                    <!-- Master Device ListBox -->
                    <ListBox x:Name="Devices" Grid.Row="2"
                             SelectionChanged="DeviceChanged"
                             Style="{StaticResource AppleMasterListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Device Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoDevice}" Fill="{StaticResource AppleAccentBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Device Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Profile.Model}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Profile.Product}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Registration Status Pill -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="8" Padding="6,2" Margin="6,0,0,0"
                                            Background="{StaticResource AppleSubtleSuccessBrush}">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource AppleSuccessBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Master Bottom Action Bar -->
                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Import" Click="Import"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    Margin="0,0,4,0" ToolTip="Import device profile or Magisk PIF JSON" />
                            <Button Grid.Column="1" Content="Export" Click="Export"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    Margin="4,0,4,0" ToolTip="Export current profile JSON" />
                            <Button Grid.Column="2" Content="Delete" Click="DeleteDevice"
                                    Style="{StaticResource AppleDangerButtonStyle}"
                                    Margin="4,0,0,0" ToolTip="Delete this device and its local sessions" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT DETAIL PANE: Selected Device & Enrolled Accounts -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,24">

                    <!-- CARD 1: Selected Device Hero Card -->
                    <Border Style="{StaticResource AppleCardBorderStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Big Device Glyph -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="13"
                                        Background="{StaticResource AppleSubtleAccentBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoDevice}" Fill="{StaticResource AppleAccentBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Active Hardware Identity" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppleAccentBrush}" />
                                    <TextBlock x:Name="DeviceInfo" Text="Select a device from the left panel." FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Action Buttons Row -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Sign in with Google" Click="SignIn"
                                            Style="{StaticResource ApplePrimaryButtonStyle}"
                                            Margin="0,0,8,0" Padding="16,8">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoGoogle}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Sign in with Google" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                    <Button Content="Register / check in" Click="Checkin"
                                            Style="{StaticResource AppleSecondaryButtonStyle}"
                                            Padding="14,8" ToolTip="Perform device check-in with Google GSF servers" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2: Accounts Enrolled on this Device -->
                    <Border Style="{StaticResource AppleCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Accounts Enrolled on this Device" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="Google Play Services &amp; Token Broker" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Custom Styled Accounts ListBox -->
                            <ListBox x:Name="Sessions"
                                     MinHeight="110" MaxHeight="220"
                                     Style="{StaticResource AppleMasterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle with Initial -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="{StaticResource AppleAccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email[0]}" Foreground="White" FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Email & Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding DisplayName, FallbackValue='Google Account'}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="2" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AppleSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Account Action Toolbar -->
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Use selected account" Click="UseAccount"
                                        Style="{StaticResource ApplePrimaryButtonStyle}"
                                        Margin="0,0,8,8" ToolTip="Set as active account in GManager" />
                                <Button Content="Sync with Google Play" Click="SyncPlay"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        Margin="0,0,8,8" ToolTip="Sync hardware specs to Google Play FDFE (Find My Device &amp; Play Store)">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoGooglePlay}" Fill="{StaticResource AppleAccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sync with Google Play" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="Test service access" Click="TestAccess"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        Margin="0,0,8,8" ToolTip="Test Gmail, Drive, and Identity token grants" />
                                <Button Content="Finish setup" Click="FinishSetup"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        Margin="0,0,8,8" ToolTip="Complete pending GMS account setup" />
                                <Button Content="Remove local session" Click="RemoveSession"
                                        Style="{StaticResource AppleDangerButtonStyle}"
                                        Margin="0,0,8,8" ToolTip="Remove session credentials from local storage" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Protocol Architecture Guide -->
                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource AppleAccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Protocol Security &amp; Isolation" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Each virtual device maintains its own Android ID, GSF check-in credentials, and token cache isolated in Windows DPAPI storage. Google Play FDFE synchronization publishes the selected hardware model to Google Play and Find My Device."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Glass Footer Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Click="CloseWindow"
                        Style="{StaticResource AppleSecondaryButtonStyle}"
                        Padding="20,6" Margin="14,0,0,0" IsCancel="True" />
                <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh"
                        Style="{StaticResource AppleSecondaryButtonStyle}"
                        Padding="14,6" Margin="8,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AppleSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Status" Text="Ready" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
