<UserControl x:Class="GManager.Views.Pages.DrivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="680" HorizontalAlignment="Left">
            <!-- Page Header -->
            <TextBlock Text="Storage Overview"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Your account storage is shared across Google Drive, Gmail, and Google Photos."
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24" />

            <!-- Main Storage Card (iOS Inset Grouped style) -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Cloud Icon & Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#E8F0FE"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoCloud}"
                                  Fill="#1A73E8"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedUsage}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FormattedFree}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 1: Smooth Progress Bar -->
                    <Grid Grid.Row="1" Margin="0,4,0,16">
                        <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}"
                                     Maximum="100"
                                     Height="10"
                                     Foreground="#1A73E8"
                                     Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Row 2: Refresh action -->
                    <ui:Button Grid.Row="2"
                               Command="{Binding RefreshQuotaCommand}"
                               HorizontalAlignment="Left"
                               Padding="12,6"
                               Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoRefresh}"
                                  Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Check Quota" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Service Breakdown Card (iOS Inset Grouped) -->
            <TextBlock Text="STORAGE BREAKDOWN"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0"
                    ClipToBounds="True"
                    Margin="0,0,0,24">
                <StackPanel>
                    <!-- Google Drive Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#1A73E8" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Drive" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Docs, Sheets, Slides, and files" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Command="{Binding OpenDriveInBrowserCommand}"
                                   Padding="12,6"
                                   FontSize="12"
                                   Content="Open Drive" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="42,0,0,0" />

                    <!-- Gmail Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#EA4335" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Gmail" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Messages and attachments, including Spam and Trash" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="42,0,0,0" />

                    <!-- Google Photos Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FBBC04" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Photos" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Original quality photos and videos" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Upgrade Card -->
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Need more space?" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Upgrade storage or clean up files using Google One." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Command="{Binding OpenGoogleOneInBrowserCommand}"
                               Appearance="Primary"
                               Padding="14,8"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Content="Google One" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
