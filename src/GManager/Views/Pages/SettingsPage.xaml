<UserControl x:Class="GManager.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="680" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Manage background services, system tray, notifications, virtual device runtime, and local preferences."
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24" />

            <!-- SECTION 1: NATIVE SERVICES & BACKGROUND -->
            <TextBlock Text="BACKGROUND &amp; PUSH SERVICES"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Margin="0,0,0,24">
                <StackPanel>
                    <!-- MCS Push Transport Status -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AppleSuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Google MCS Push Transport" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding McsStatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{StaticResource AppleSubtleSuccessBrush}"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="ONLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppleSuccessBrush}" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="18,0,18,0" />

                    <!-- Background Notifications Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Windows Toast Notifications" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Show interactive notifications when new emails or drive updates arrive" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding SendTestNotificationCommand}"
                                       Content="Test Toast"
                                       Padding="10,5"
                                       FontSize="11.5"
                                       CornerRadius="6"
                                       Margin="0,0,12,0" />
                            <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="18,0,18,0" />

                    <!-- Minimize to System Tray Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Minimize to System Tray on Close" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Keep GManager running in the background taskbar tray when closing the window" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="18,0,18,0" />

                    <!-- Auto-start Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Launch on Windows Startup" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Automatically start GManager minimized in tray when you log in to Windows" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: VIRTUAL ANDROID RUNTIME & DEVICES -->
            <TextBlock Text="VIRTUAL ANDROID RUNTIME (WINGCORE)"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <Ellipse Width="7" Height="7" Fill="#1A73E8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Virtual Device Registration" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceInfoText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="#141A73E8"
                                BorderBrush="#1A73E8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="#1A73E8" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="18,0,18,0" />

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Native Device &amp; Account Management" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Manage virtual device hardware profiles, check-in status, and enrolled Google account tokens." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Command="{Binding OpenDevicesCommand}"
                                   Content="Manage Devices"
                                   Padding="14,6"
                                   CornerRadius="6"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 3: APPEARANCE & SYNC -->
            <TextBlock Text="APPEARANCE &amp; SYNC"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Margin="0,0,0,24">
                <StackPanel>
                    <!-- Theme Selector Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="App Theme" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Choose Light, Dark, or follow Windows system theme" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Width="130"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="18,0,18,0" />

                    <!-- Smart Event-Driven Sync Info Row -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Smart Event-Driven Synchronization" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Instant push notifications, auto-sync on Windows wake &amp; network reconnect. Zero periodic battery drain." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{StaticResource AppleSubtleSuccessBrush}"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppleSuccessBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 4: STORAGE & LOCAL DATA -->
            <TextBlock Text="STORAGE &amp; LOCAL SECURITY"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Padding="18,14"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Application Data &amp; Runtime Database" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding DataDirectoryText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Encrypted locally using Windows DPAPI (AES-256-GCM). No cloud sync of credentials." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Command="{Binding OpenDataFolderCommand}"
                               Content="Open Folder"
                               Padding="14,6"
                               CornerRadius="6"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Save Action Button -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Command="{Binding SaveSettingsCommand}"
                           Appearance="Primary"
                           Padding="24,8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Content="Save Preferences" />

                <!-- Save confirmation -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Visibility="{Binding SaveSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Path Data="{StaticResource GeoCheckmark}"
                          Fill="{StaticResource AppleSuccessBrush}"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Preferences saved successfully" Foreground="{StaticResource AppleSuccessBrush}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- SECTION 5: ABOUT & PRIVACY -->
            <TextBlock Text="ABOUT &amp; ARCHITECTURE"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="4,0,0,8" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Padding="20,16"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="GManager — WinGCore Runtime" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Version 1.1.0 · Native Windows 11 / .NET 8 / microG Architecture" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" />
                    <TextBlock Text="Virtual Android device registration with direct Google Mobile Connection Server (MCS) transport. All tokens and credentials are encrypted strictly on your local machine using Windows DPAPI (AES-256-GCM). Zero third-party telemetry, zero external servers."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
