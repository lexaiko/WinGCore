<UserControl x:Class="GManager.Views.Pages.InboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:GManager.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="18,14,18,18">
        <Grid.ColumnDefinitions>
            <!-- Left Column: Message List (Resizable) -->
            <ColumnDefinition Width="380" MinWidth="290" MaxWidth="520" />
            <!-- Splitter Handle -->
            <ColumnDefinition Width="10" />
            <!-- Right Column: Reading Pane -->
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT PANE: INBOX LIST                      -->
        <!-- ========================================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Search & Refresh -->
                <RowDefinition Height="Auto" /> <!-- Filter Chips -->
                <RowDefinition Height="*" />    <!-- Message List -->
            </Grid.RowDefinitions>

            <!-- Search Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search in mail..."
                                ClearButtonEnabled="True"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Padding="36,8,12,8" />
                    <Path Data="{StaticResource GeoSearch}"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                          Width="13"
                          Height="13"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          IsHitTestVisible="False" />
                </Grid>

                <ui:Button Grid.Column="1"
                           Command="{Binding RefreshCommand}"
                           Margin="8,0,0,0"
                           Padding="10,8"
                           CornerRadius="8"
                           ToolTip="Refresh inbox">
                    <Path Data="{StaticResource GeoRefresh}"
                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                          Width="13"
                          Height="13"
                          Stretch="Uniform" />
                </ui:Button>
            </Grid>

            <!-- Filter Chips (All / Unread / Starred) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Command="{Binding SetFilterCommand}"
                           CommandParameter="All"
                           Content="All"
                           FontSize="12"
                           FontWeight="Medium"
                           Padding="12,5"
                           Margin="0,0,6,0"
                           CornerRadius="14"
                           BorderThickness="1"
                           Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                    <Setter Property="Background" Value="#1A73E8" />
                                    <Setter Property="BorderBrush" Value="#1A73E8" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Command="{Binding SetFilterCommand}"
                           CommandParameter="Unread"
                           Content="Unread"
                           FontSize="12"
                           FontWeight="Medium"
                           Padding="12,5"
                           Margin="0,0,6,0"
                           CornerRadius="14"
                           BorderThickness="1"
                           Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnreadFilter}" Value="True">
                                    <Setter Property="Background" Value="#1A73E8" />
                                    <Setter Property="BorderBrush" Value="#1A73E8" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Command="{Binding SetFilterCommand}"
                           CommandParameter="Starred"
                           Content="Starred"
                           FontSize="12"
                           FontWeight="Medium"
                           Padding="12,5"
                           CornerRadius="14"
                           BorderThickness="1"
                           Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStarredFilter}" Value="True">
                                    <Setter Property="Background" Value="#E37400" />
                                    <Setter Property="BorderBrush" Value="#E37400" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>

            <!-- Message List Card -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding FilteredMessages.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="#141A73E8"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <Path Data="{StaticResource GeoCheckmark}"
                                  Fill="#1A73E8"
                                  Width="24"
                                  Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No messages found"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Your inbox is clear"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Virtualized List -->
                    <ListView ItemsSource="{Binding FilteredMessages}"
                              SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="14,10"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#1A73E8" />
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,0,0,1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Dot -->
                                        <ColumnDefinition Width="Auto" /> <!-- Avatar -->
                                        <ColumnDefinition Width="*" />    <!-- Details -->
                                        <ColumnDefinition Width="Auto" /> <!-- Star -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Unread Dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="7"
                                             Height="7"
                                             Fill="#1A73E8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border Grid.Column="0"
                                            Width="7"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsUnread, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <!-- Sender Avatar -->
                                    <Border Grid.Column="1"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#E8F0FE"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0">
                                        <TextBlock Text="{Binding SenderInitials}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#1A73E8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Content -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Sender + Time -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SenderName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FormattedTime}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <!-- Subject -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Subject}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Snippet -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Snippet}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="32" />
                                    </Grid>

                                    <!-- Quick Star Toggle -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4"
                                            VerticalAlignment="Top"
                                            Margin="4,2,0,0">
                                        <Grid>
                                            <!-- Starred (Filled Yellow) -->
                                            <Path Data="{StaticResource GeoStar}"
                                                  Fill="#F4B400"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Visibility="{Binding IsStarred, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <!-- Unstarred (Outline) -->
                                            <Path Data="{StaticResource GeoStarBorder}"
                                                  Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Visibility="{Binding IsStarred, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- GRID SPLITTER                              -->
        <!-- ========================================== -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE" />

        <!-- ========================================== -->
        <!-- RIGHT PANE: RICH READING PANE              -->
        <!-- ========================================== -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <!-- EMPTY STATE (No Email Selected) -->
                <Grid Visibility="{Binding HasSelectedMessage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="72"
                                Height="72"
                                CornerRadius="36"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Data="{StaticResource GeoMail}"
                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                  Width="32"
                                  Height="32"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select an email to read"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Choose a conversation from the list to preview full details, attachments, and reply."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   MaxWidth="360"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- SELECTED EMAIL READING PANE -->
                <Grid Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
                        <RowDefinition Height="Auto" /> <!-- Message Header (Subject, Sender, Recipients, Time) -->
                        <RowDefinition Height="Auto" /> <!-- Loading Indicator -->
                        <RowDefinition Height="*" />    <!-- Rich Message Body -->
                        <RowDefinition Height="Auto" /> <!-- Attachments Area -->
                        <RowDefinition Height="Auto" /> <!-- Quick Reply Area -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Action Toolbar -->
                    <Border Grid.Row="0"
                            Padding="16,10"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Close / Deselect Button -->
                            <ui:Button Grid.Column="0"
                                       Command="{Binding CloseDetailCommand}"
                                       ToolTip="Close message"
                                       Padding="8,6"
                                       CornerRadius="6">
                                <Path Data="{StaticResource GeoDismiss}"
                                      Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform" />
                            </ui:Button>

                            <!-- Right Toolbar Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!-- Reply Button -->
                                <ui:Button Command="{Binding StartReplyCommand}"
                                           Margin="4,0"
                                           Padding="12,6"
                                           CornerRadius="6"
                                           ToolTip="Reply directly">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoReply}"
                                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0" />
                                        <TextBlock Text="Reply" FontSize="12.5" FontWeight="Medium" />
                                    </StackPanel>
                                </ui:Button>

                                <!-- Star Button -->
                                <ui:Button Command="{Binding ToggleStarCommand}"
                                           CommandParameter="{Binding SelectedMessage}"
                                           Margin="4,0"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           ToolTip="Star / Unstar">
                                    <Grid>
                                        <Path Data="{StaticResource GeoStar}"
                                              Fill="#F4B400"
                                              Width="13"
                                              Height="13"
                                              Stretch="Uniform"
                                              Visibility="{Binding SelectedMessage.IsStarred, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Path Data="{StaticResource GeoStarBorder}"
                                              Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                              Width="13"
                                              Height="13"
                                              Stretch="Uniform"
                                              Visibility="{Binding SelectedMessage.IsStarred, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </ui:Button>

                                <!-- Mark as Unread Button -->
                                <ui:Button Command="{Binding MarkAsReadCommand}"
                                           CommandParameter="{Binding SelectedMessage}"
                                           Margin="4,0"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           ToolTip="Mark as read">
                                    <Path Data="{StaticResource GeoCheckmark}"
                                          Fill="#1A73E8"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform" />
                                </ui:Button>

                                <!-- Trash Button -->
                                <ui:Button Command="{Binding TrashMessageCommand}"
                                           CommandParameter="{Binding SelectedMessage}"
                                           Margin="4,0"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           ToolTip="Delete message">
                                    <Path Data="{StaticResource GeoTrash}"
                                          Fill="#D93025"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform" />
                                </ui:Button>

                                <!-- Open in Web Browser -->
                                <ui:Button Command="{Binding OpenInBrowserCommand}"
                                           CommandParameter="{Binding SelectedMessage}"
                                           Margin="4,0"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           ToolTip="Open in Gmail Web">
                                    <Path Data="{StaticResource GeoOpenInNew}"
                                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Message Header -->
                    <Border Grid.Row="1"
                            Padding="20,16"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Subject Title -->
                                <RowDefinition Height="Auto" /> <!-- Sender & Time -->
                                <RowDefinition Height="Auto" /> <!-- Recipients (To / Cc) -->
                            </Grid.RowDefinitions>

                            <!-- Subject Title -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedMessage.Subject}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <!-- Sender Info -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sender Avatar -->
                                <Border Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="#E8F0FE"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMessage.SenderInitials}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#1A73E8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Sender Name and Address -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMessage.SenderName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedMessage.SenderEmail}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- Precise Timestamp -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedMessage.InternalDate, StringFormat='{}{0:ddd, MMM d, yyyy · h:mm tt}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Recipients Details -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="52,2,0,0"
                                        Visibility="{Binding SelectedMessage.RecipientTo, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <TextBlock Text="To: "
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding SelectedMessage.RecipientTo}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Loading State -->
                    <ProgressBar Grid.Row="2"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Row 3: Rich Message Body -->
                    <Grid Grid.Row="3">
                        <!-- HTML Web Browser Renderer (When HTML is present) -->
                        <WebBrowser helpers:WebBrowserHelper.Html="{Binding SelectedMessage.BodyHtml}"
                                    Visibility="{Binding SelectedMessage.BodyHtml, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                        <!-- Plain Text Renderer (Fallback when BodyHtml is empty) -->
                        <ScrollViewer Visibility="{Binding SelectedMessage.BodyHtml, Converter={StaticResource StringNotEmptyToVisibilityConverter}, ConverterParameter=Inverse}"
                                      Padding="20,16"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedMessage.BodyText, Mode=OneWay, FallbackValue='(No text content)'}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontSize="13.5"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Row 4: Attachments Area -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10"
                            Visibility="{Binding SelectedMessage.Attachments.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource GeoAttach}"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Attachments"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedMessage.Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                Margin="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0"
                                                      Data="{StaticResource GeoAttach}"
                                                      Fill="#1A73E8"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Filename}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               MaxWidth="180"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding FormattedSize}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <ui:Button Grid.Column="2"
                                                           Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="6,4"
                                                           CornerRadius="6"
                                                           ToolTip="Download attachment">
                                                    <Path Data="{StaticResource GeoDownload}"
                                                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="Uniform" />
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Row 5: Inline Quick Reply Box -->
                    <Border Grid.Row="5"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12"
                            Visibility="{Binding IsReplying, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedMessage.SenderName, StringFormat='Reply to {0}...'}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <ui:TextBox Grid.Row="1"
                                        Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Write your reply..."
                                        AcceptsReturn="True"
                                        MinHeight="80"
                                        MaxHeight="160"
                                        FontSize="13"
                                        Padding="10"
                                        Margin="0,0,0,10" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Command="{Binding CancelReplyCommand}"
                                           Content="Cancel"
                                           Margin="0,0,8,0"
                                           Padding="14,6"
                                           CornerRadius="6" />

                                <ui:Button Command="{Binding SendReplyCommand}"
                                           Padding="16,6"
                                           CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoSend}"
                                              Fill="#FFFFFF"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0" />
                                        <TextBlock Text="Send" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="#1A73E8" />
                                            <Setter Property="BorderBrush" Value="#1A73E8" />
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
