<ui:FluentWindow x:Class="GManager.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:GManager.Views.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  Title="GManager"
                  Height="720"
                  Width="1060"
                  MinHeight="600"
                  MinWidth="860"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  ShowInTaskbar="True"
                  Icon="pack://application:,,,/Assets/app_logo.jpg">

    <Window.Resources>
        <!-- Sleek macOS Sequoia Navigation RadioButton Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="12,9"
                                Margin="0,0,0,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AppleSubtleAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AppleAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Action Button Style (Matches Nav Items Seamlessly) -->
        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="12,9"
                                Margin="0,0,0,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom Fluent TitleBar -->
            <RowDefinition Height="*" />    <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     VerticalAlignment="Center">
            <ui:TitleBar.Header>
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Account Switcher Trigger (Signature Apple Pill in Header) -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleAccountSwitcherCommand}"
                               Padding="4,3,10,3"
                               CornerRadius="18"
                               Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                               BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               Margin="0,0,16,0"
                               ToolTip="Google Account">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Circular Avatar with Clean Style -->
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource AppleAccentBrush}"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding ActiveAccount.Initials, FallbackValue='G'}"
                                               Foreground="#FFFFFF"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding ActiveAccount.AvatarLocalPath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- User Display Name -->
                            <TextBlock Text="{Binding ActiveAccount.DisplayName, FallbackValue='Sign In'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Unread Count Pill (Only visible when ActiveAccount != null && UnreadCount > 0) -->
                            <Border Background="{StaticResource AppleAccentBrush}"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding ActiveAccount.UnreadCount, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                <TextBlock Text="{Binding ActiveAccount.UnreadCount}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                            </Border>

                            <!-- Clean Chevron Down Vector -->
                            <Path Data="{StaticResource GeoChevronDown}"
                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body: Navigation Rail + Page Container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" /> <!-- Clean iOS / macOS sidebar -->
                <ColumnDefinition Width="*" />   <!-- Dynamic Page Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource AppleSidebarGlassBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16,12,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Section: GOOGLE SERVICES -->
                        <TextBlock Text="SERVICES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,0,8" />

                        <!-- Inbox Nav Item -->
                        <RadioButton x:Name="NavInbox"
                                     GroupName="NavMenu"
                                     IsChecked="True"
                                     Click="OnNavInboxClicked"
                                     Style="{StaticResource SidebarNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource GeoMail}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Gmail Inbox" FontSize="13" VerticalAlignment="Center" />
                                <!-- Unread Count Badge -->
                                <Border Grid.Column="2" Background="{StaticResource AppleAccentBrush}" CornerRadius="8" Padding="7,1.5" VerticalAlignment="Center"
                                        Visibility="{Binding ActiveAccount.UnreadCount, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                    <TextBlock Text="{Binding ActiveAccount.UnreadCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Storage Nav Item -->
                        <RadioButton x:Name="NavStorage"
                                     GroupName="NavMenu"
                                     Click="OnNavStorageClicked"
                                     Style="{StaticResource SidebarNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource GeoCloud}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Google Drive" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <!-- Subtle Divider -->
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,12,8,12" />

                        <!-- Section: HARDWARE & RUNTIME -->
                        <TextBlock Text="SYSTEM &amp; RUNTIME" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,0,8" />

                        <!-- Devices Studio Nav Button -->
                        <Button Command="{Binding OpenDevicesCommand}"
                                Style="{StaticResource SidebarActionButtonStyle}"
                                HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource GeoDevice}"
                                      Fill="{StaticResource AppleAccentBrush}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Virtual Devices" FontSize="13" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{StaticResource AppleSubtleAccentBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Studio" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AppleAccentBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Settings Nav Item -->
                        <RadioButton x:Name="NavSettings"
                                     GroupName="NavMenu"
                                     Click="OnNavSettingsClicked"
                                     Style="{StaticResource SidebarNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource GeoSettings}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Preferences" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Sidebar: Runtime Status Pill -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource AppleSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MCS Transport" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Google Push Active" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Active Page Content Host -->
            <ContentControl x:Name="PageContentHost"
                            Grid.Column="1"
                            Focusable="False" />
        </Grid>

        <!-- Signature iOS Google Account Switcher Flyout Modal -->
        <controls:AvatarSheet Grid.Row="0"
                               Grid.RowSpan="2"
                               Visibility="{Binding IsAccountSwitcherOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</ui:FluentWindow>
