<ui:FluentWindow x:Class="GManager.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:GManager.Views.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  Title="GManager"
                  Height="720"
                  Width="1060"
                  MinHeight="600"
                  MinWidth="860"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  ShowInTaskbar="True"
                  Icon="pack://application:,,,/Assets/app_logo.jpg">

    <Window.Resources>
        <!-- Sleek Apple / Fluent Navigation RadioButton Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="12,10"
                                Margin="0,0,0,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1E1A73E8" />
                                <Setter Property="Foreground" Value="#1A73E8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom Fluent TitleBar -->
            <RowDefinition Height="*" />    <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     VerticalAlignment="Center">
            <ui:TitleBar.Header>
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Account Switcher Trigger (Signature iOS Pill in Header) -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleAccountSwitcherCommand}"
                               Padding="4,3,10,3"
                               CornerRadius="18"
                               Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                               BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               Margin="0,0,16,0"
                               ToolTip="Google Account">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Circular Avatar with Google Blue Ring -->
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    BorderBrush="#1A73E8"
                                    BorderThickness="1.5"
                                    Background="#1A73E8"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding ActiveAccount.Initials, FallbackValue='G'}"
                                               Foreground="#FFFFFF"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding ActiveAccount.AvatarLocalPath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- User Display Name -->
                            <TextBlock Text="{Binding ActiveAccount.DisplayName, FallbackValue='Sign In'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Unread Count Pill (Only visible when ActiveAccount != null && UnreadCount > 0) -->
                            <Border Background="#1A73E8"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding ActiveAccount.UnreadCount, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                <TextBlock Text="{Binding ActiveAccount.UnreadCount}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                            </Border>

                            <!-- Clean Chevron Down Vector -->
                            <Path Data="{StaticResource GeoChevronDown}"
                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body: Navigation Rail + Page Container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" /> <!-- Clean iOS / macOS sidebar -->
                <ColumnDefinition Width="*" />   <!-- Dynamic Page Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16,12,16">
                <StackPanel>
                    <!-- Inbox Nav Item -->
                    <RadioButton x:Name="NavInbox"
                                 GroupName="NavMenu"
                                 IsChecked="True"
                                 Click="OnNavInboxClicked"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource GeoMail}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Margin="2,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Inbox"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                            <!-- Unread Count Badge -->
                            <Border Grid.Column="2"
                                    Background="#1A73E8"
                                    CornerRadius="8"
                                    Padding="7,1.5"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ActiveAccount.UnreadCount, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                <TextBlock Text="{Binding ActiveAccount.UnreadCount}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- Storage Nav Item -->
                    <RadioButton x:Name="NavStorage"
                                 GroupName="NavMenu"
                                 Click="OnNavStorageClicked"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource GeoCloud}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Margin="2,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Storage"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <!-- Settings Nav Item -->
                    <Button Content="Devices and accounts" Command="{Binding OpenDevicesCommand}"
                            Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                    <RadioButton x:Name="NavSettings"
                                 GroupName="NavMenu"
                                 Click="OnNavSettingsClicked"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource GeoSettings}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Margin="2,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Active Page Content Host -->
            <ContentControl x:Name="PageContentHost"
                            Grid.Column="1"
                            Focusable="False" />
        </Grid>

        <!-- Signature iOS Google Account Switcher Flyout Modal -->
        <controls:AvatarSheet Grid.Row="0"
                               Grid.RowSpan="2"
                               Visibility="{Binding IsAccountSwitcherOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</ui:FluentWindow>
