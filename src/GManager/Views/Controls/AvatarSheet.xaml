<UserControl x:Class="GManager.Views.Controls.AvatarSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <!-- Backdrop dim overlay -->
        <Border Background="#44000000" MouseDown="OnBackdropClicked" />

        <!-- Floating iOS-style card sheet -->
        <Border Width="370"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,48,20,0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Color="#000000"
                                  Opacity="0.35"
                                  ShadowDepth="10"
                                  Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header with Close & Google Logo -->
                    <RowDefinition Height="Auto" /> <!-- Active Account Card -->
                    <RowDefinition Height="Auto" /> <!-- Hairline Divider -->
                    <RowDefinition Height="*" MaxHeight="220" />   <!-- Other Accounts List -->
                    <RowDefinition Height="Auto" /> <!-- Hairline Divider -->
                    <RowDefinition Height="Auto" /> <!-- Actions (Add account, Terms) -->
                </Grid.RowDefinitions>

                <!-- Row 0: Top Bar with Google Brand & Close Button -->
                <Grid Grid.Row="0" Margin="16,14,14,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoGoogle}"
                              Fill="#4285F4"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Google"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Close button (top right) -->
                    <ui:Button Command="{Binding ToggleAccountSwitcherCommand}"
                               HorizontalAlignment="Right"
                               Padding="6"
                               Background="Transparent"
                               BorderThickness="0"
                               ToolTip="Close">
                        <Path Data="{StaticResource GeoDismiss}"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"
                              Width="11"
                              Height="11"
                              Stretch="Uniform" />
                    </ui:Button>
                </Grid>

                <!-- Row 1: Active Account Card -->
                <Grid Grid.Row="1" Margin="20,14,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Ring -->
                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{StaticResource AppleAccentBrush}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding ActiveAccount.Initials, FallbackValue='G'}"
                                       Foreground="#FFFFFF"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding ActiveAccount.AvatarLocalPath}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Info & Action -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveAccount.DisplayName, FallbackValue='No Account Selected'}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding ActiveAccount.Email, FallbackValue='Sign in to connect'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,8" />

                        <ui:Button Command="{Binding OpenInBrowserCommand}"
                                   CommandParameter="myaccount"
                                   HorizontalAlignment="Left"
                                   Padding="12,5"
                                   CornerRadius="14"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Content="Manage your Google Account" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Divider -->
                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="16,0,16,0" />

                <!-- Row 3: Other Accounts List -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,4">
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           HorizontalContentAlignment="Stretch"
                                           Padding="14,8"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Margin="10,2"
                                           CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                Background="{StaticResource AppleSubtleAccentBrush}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}"
                                                           Foreground="{StaticResource AppleAccentBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding AvatarLocalPath}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Name & Email -->
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Active / Unread Badge & Delete -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#1A73E8"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    Visibility="{Binding UnreadCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <TextBlock Text="{Binding UnreadCount}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF" />
                                            </Border>

                                            <!-- Remove account button -->
                                            <ui:Button Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="6,4"
                                                       Margin="6,0,0,0"
                                                       ToolTip="Remove account">
                                                <Path Data="{StaticResource GeoDismiss}"
                                                      Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Row 4: Divider -->
                <Border Grid.Row="4"
                        Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="16,0,16,0" />

                <!-- Row 5: Actions -->
                <StackPanel Grid.Row="5" Margin="16,12,16,14">
                    <!-- Add Another Account Button -->
                    <ui:Button Command="{Binding AddNewAccountCommand}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Padding="0,10"
                               CornerRadius="10"
                               Appearance="Primary">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoAddUser}"
                                  Fill="#FFFFFF"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Add another account"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Footer links (iOS style) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Privacy Policy"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Terms of Service"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
