<Window x:Class="GManager.Views.NativeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Google sign-in — GManager" Width="540" Height="760" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16,12">
            <TextBlock Text="Sign in on accounts.google.com" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="Status" Text="Preparing a private Google sign-in session…" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="Back" Click="Back" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Finish sign-in" Click="Finish" Padding="16,7" Margin="0,0,8,0" ToolTip="Use after completing Google sign-in if the window stays open."/>
            <Button Content="Cancel" Click="Cancel" Padding="16,7" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
