<ui:FluentWindow x:Class="GManager.Views.NativeLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="Google Sign-In — GManager"
                 Width="560" Height="780" MinWidth="460" MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom Fluent TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Glass Header Info Card -->
            <RowDefinition Height="*" />    <!-- WebView2 Browser Surface -->
            <RowDefinition Height="Auto" /> <!-- Glass Action Footer -->
        </Grid.RowDefinitions>

        <!-- macOS / Fluent Glass TitleBar -->
        <ui:TitleBar Grid.Row="0" Margin="14,6,14,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoGoogle}" Fill="{StaticResource AppleAccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Google Sign-In" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Glass Header Info Card -->
        <Border Grid.Row="1"
                Background="{StaticResource AppleCardGlassBrush}"
                BorderBrush="{StaticResource AppleGlassBorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="18,12" Margin="0,4,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                        Background="{StaticResource AppleSubtleAccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoShield}" Fill="{StaticResource AppleAccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Android System WebView Authentication" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="Status" Text="Preparing a private Google sign-in session…" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Browser Surface (Contained in smooth rounded glass frame) -->
        <Border Grid.Row="2"
                Margin="14,0,14,12"
                CornerRadius="12"
                ClipToBounds="True"
                Background="#FFFFFF"
                BorderBrush="{StaticResource AppleGlassBorderBrush}"
                BorderThickness="1">
            <wv:WebView2 x:Name="Browser" />
        </Border>

        <!-- Glass Action Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource AppleHeaderGlassBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back" Click="Back"
                            Style="{StaticResource AppleSecondaryButtonStyle}"
                            Padding="16,7" Margin="0,0,8,0" />
                    <Button Content="Finish sign-in" Click="Finish"
                            Style="{StaticResource ApplePrimaryButtonStyle}"
                            Padding="18,7" Margin="0,0,8,0"
                            ToolTip="Use after completing Google sign-in if the window stays open." />
                    <Button Content="Cancel" Click="Cancel"
                            Style="{StaticResource AppleDangerButtonStyle}"
                            Padding="16,7" IsCancel="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoKey}" Fill="{DynamicResource TextFillColorSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Secured by DPAPI" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
