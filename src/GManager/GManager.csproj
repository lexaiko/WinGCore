<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GManager.Platform.Windows/GManager.Platform.Windows.csproj" />
    <ProjectReference Include="../GManager.RuntimeHost/GManager.RuntimeHost.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- UI Framework & MVVM -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Local Database -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />

    <!-- Windows Toast Notifications -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />

    <!-- Dependency Injection & Hosting -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\GManager.RuntimeHost\GManager.RuntimeHost.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="NativeRuntimeTarget" />
    </MSBuild>
    <PropertyGroup>
      <NativeRuntimeOutput>@(NativeRuntimeTarget->'%(RootDir)%(Directory)')</NativeRuntimeOutput>
    </PropertyGroup>
    <ItemGroup>
      <NativeRuntimeFiles Include="$(NativeRuntimeOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeRuntimeFiles)" DestinationFiles="@(NativeRuntimeFiles->'$(OutDir)NativeRuntime\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNativeRuntime" AfterTargets="Publish">
    <ItemGroup>
      <NativeRuntimePublishFiles Include="$(OutDir)NativeRuntime\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeRuntimePublishFiles)" DestinationFiles="@(NativeRuntimePublishFiles->'$(PublishDir)NativeRuntime\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\app_logo.jpg" />
  </ItemGroup>

</Project>
